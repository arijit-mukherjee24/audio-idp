#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/security_check.py --staged
elif [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/security_check.py --staged
elif command -v py >/dev/null 2>&1; then
    exec py -3.13 scripts/security_check.py --staged
else
    exec python3 scripts/security_check.py --staged
fi
