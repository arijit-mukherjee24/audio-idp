# Copy to .env for local configuration. Never commit a real key.
# .env loads automatically; existing shell variables take precedence. Restart after edits.
AUDIO_IDP_DATA=.data
AUDIO_IDP_WORKERS=2
AUDIO_IDP_TRANSCRIBE_BUCKET=am-sc-test-bucket
AUDIO_IDP_TRANSCRIBE_REGION=us-east-1
# Azure Fast Transcription requires a Standard S0 Speech resource. F0 is unsupported.
AZURE_SPEECH_MODE=fast
AZURE_SPEECH_AUTH=key
AZURE_SPEECH_KEY=
# Required: use the resource's HTTPS base endpoint:
# https://your-speech-resource.cognitiveservices.azure.com (no API path).
AZURE_SPEECH_ENDPOINT=
# Fast mode also supports AUTH=entra with requirements-azure.txt, an Azure login,
# a custom resource endpoint, and the Cognitive Services Speech User role.
# AWS credentials belong in your user-level AWS default profile, never here.
