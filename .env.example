# Optional non-secret settings. The app does NOT load .env files automatically.
# Set these as shell environment variables before starting the application.
AUDIO_IDP_DATA=.data
AUDIO_IDP_WORKERS=2
AUDIO_IDP_TRANSCRIBE_BUCKET=am-sc-test-bucket
AUDIO_IDP_TRANSCRIBE_REGION=us-east-1
# Azure Speech Fast Transcription (use your resource's HTTPS base endpoint).
AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com
AZURE_SPEECH_AUTH=key
# Set AZURE_SPEECH_KEY securely in your shell; never commit a real key here.
# Alternatively use AZURE_SPEECH_AUTH=entra with an Azure login and Speech User role.
# AWS credentials belong in your user-level AWS default profile, never here.
